module full_adder(a,b,c,cout,s);
  input logic a, b, c;
  output logic cout, s;
  assign s = a^b^c;
  assign cout = (a&b)|(b&c)|(a&c);
endmodule




module full_adder_tb();
  logic a, b, c, c1, s1, cout, s;
  full_adder uut (.a(a), .b(b), .c(c), .cout(cout), .s(s) );
  always@(*)
    begin
      {c1, s1 } = a+b+c;
      if((s==s1) && (cout==c1))
      $display("success");
      else
        $display("Fail");
    end
  initial
  begin 
    $dumpfile("full_adder.vcd");
    $dumpvars(0,full_adder_tb);
    $display($time, "a=%b, b=%b, cout=%b, c=%b", a, b, cout, c, s);
    for(int i=0; i<8; i++)
      #5 {a,b,c} = i[2:0];
  end
endmodule
